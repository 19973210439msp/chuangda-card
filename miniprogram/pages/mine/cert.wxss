.company-line {
  display: block;
  margin-top: 8rpx;
  color: #182850;
  font-size: 28rpx;
  line-height: 1.5;
}

.cert-code {
  display: block;
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #e6e8ee;
  border-radius: 8rpx;
  background: #ffffff;
  color: #3a3f4b;
  font-size: 28rpx;
  line-height: 88rpx;
}

.company-pick {
  display: flex;
  align-items: center;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e6e8ee;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.company-pick-text {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #3a3f4b;
  font-size: 30rpx;
  line-height: 88rpx;
}

.company-pick-more {
  flex: none;
  margin-left: 16rpx;
  color: #182850;
  font-size: 28rpx;
  line-height: 88rpx;
}

.company-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.45);
}

.company-sheet {
  width: 100%;
  max-height: 70vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.company-sheet-title {
  display: block;
  color: #182850;
  font-size: 34rpx;
  font-weight: 600;
}

.company-list {
  max-height: 48vh;
  margin-top: 16rpx;
}

.company-option {
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #e6e8ee;
}

.company-option text {
  display: block;
  color: #3a3f4b;
  font-size: 30rpx;
  line-height: 1.5;
}

.company-option.on text {
  color: #182850;
  font-weight: 600;
}

.company-close {
  margin-top: 20rpx;
  height: 88rpx;
  border-radius: 8rpx;
  background: #f3f6fa;
  color: #182850;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}
