<nav-bar title="企业认证"></nav-bar>
<scroll-view class="sub-scroll" scroll-y style="height: {{scrollHeight}}px">
  <view class="sub-body">
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <view class="card-block">
      <text class="hint">所有企业（包括总公司）都需要先认证。认证通过且企业已获得模板后，才能创建对应企业名片。</text>
      <block wx:if="{{certified.length}}">
        <text class="label">已认证</text>
        <text class="company-line" wx:for="{{certified}}" wx:key="companyId">{{item.companyName}}</text>
      </block>
      <block wx:if="{{pending.length}}">
        <text class="label">审核中</text>
        <text class="company-line" wx:for="{{pending}}" wx:key="companyId">{{item.companyName}}</text>
      </block>
      <text class="label">选择企业</text>
      <view class="company-pick" bindtap="onOpenCompanies">
        <text class="company-pick-text">{{companyNames[companyIndex] || '暂无可选企业'}}</text>
        <text class="company-pick-more">查看</text>
      </view>
      <button class="primary" bindtap="onApplyCert">申请认证</button>
    </view>
  </view>
</scroll-view>
<view class="company-mask" wx:if="{{companyOpen}}" bindtap="onCloseCompanies" catchtouchmove="onHoldCompanies">
  <view class="company-sheet" catchtap="onHoldCompanies">
    <text class="company-sheet-title">选择企业</text>
    <scroll-view class="company-list" scroll-y>
      <view
        class="company-option {{companyIndex === index ? 'on' : ''}}"
        wx:for="{{companies}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="onChooseCompany"
      >
        <text>{{item.name}}</text>
      </view>
    </scroll-view>
    <view class="company-close" bindtap="onCloseCompanies">关闭</view>
  </view>
</view>
