.mine-scroll {
  width: 100%;
  background: #f5f6f8;
}

.mine-body {
  box-sizing: border-box;
  min-height: 100%;
  padding: 24rpx 0 48rpx;
  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.group {
  background: #ffffff;
}

.row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  margin-left: 32rpx;
  padding-right: 24rpx;
  border-bottom: 1rpx solid #ededed;
}

.row:last-child {
  border-bottom: none;
}

.ico {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.name {
  flex: 1;
  color: #1a1a1a;
  font-size: 30rpx;
}

.value {
  max-width: 280rpx;
  margin-right: 8rpx;
  color: #8a9099;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chev {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.bind {
  margin-right: 4rpx;
  padding: 6rpx 22rpx;
  border: 1rpx solid #182850;
  border-radius: 28rpx;
  color: #182850;
  font-size: 24rpx;
  line-height: 1.4;
}

.net-box {
  margin-top: 80rpx;
  padding: 20rpx 32rpx 40rpx;
  text-align: center;
}

.net-line {
  display: block;
  font-size: 22rpx;
  color: #9aa5b8;
  word-break: break-all;
}

.net-tip {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #c0c7d2;
}
