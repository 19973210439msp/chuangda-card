.bg-img {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
}

.mine-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  background-color: transparent;
  background-image: none;
}

.mine-body {
  position: relative;
  box-sizing: border-box;
  min-height: 100%;
  padding: 32rpx 28rpx 48rpx;
  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.group {
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 40, 89, 0.08);
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  margin-left: 32rpx;
  padding-right: 24rpx;
  border-bottom: 1rpx solid #ededed;
}

.row:last-child {
  border-bottom: none;
}

.row-static {
  border-bottom: none;
}

.ico {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.name {
  flex: 1;
  color: #333333;
  font-size: 30rpx;
}

.value {
  max-width: 280rpx;
  margin-right: 8rpx;
  color: #666666;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chev {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.bind {
  margin-right: 4rpx;
  padding: 6rpx 22rpx;
  border: 1rpx solid #182850;
  border-radius: 28rpx;
  color: #182850;
  font-size: 24rpx;
  line-height: 1.4;
}
