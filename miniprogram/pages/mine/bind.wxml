<nav-bar title="{{title}}"></nav-bar>
<scroll-view class="sub-scroll" scroll-y style="height: {{scrollHeight}}px">
  <view class="sub-body">
    <text class="claim-tip" wx:if="{{type === 'phone'}}">填写管理员导入表格中的手机号。验证通过后，这张名片会接到当前微信。</text>
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <view class="ok" wx:if="{{hint}}">{{hint}}</view>
    <text class="label">{{type === 'phone' ? '新手机号' : '新邮箱'}}</text>
    <input class="input" placeholder="{{type === 'phone' ? '请输入新手机号' : '请输入新邮箱'}}" placeholder-class="ph" value="{{value}}" bindinput="onValue" />
    <button class="ghost" bindtap="onSend">{{type === 'phone' ? '获取短信验证码' : '获取邮箱验证码'}}</button>
    <text class="label">验证码</text>
    <input class="input" placeholder="请输入验证码" placeholder-class="ph" value="{{code}}" bindinput="onCode" />
    <button class="primary" bindtap="onSave">保存</button>
  </view>
</scroll-view>
<app-tab></app-tab>
