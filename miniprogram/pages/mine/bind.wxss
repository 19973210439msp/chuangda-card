.claim-tip {
  display: block;
  color: #5c6370;
  font-size: 26rpx;
  line-height: 1.6;
}

.sub-body .label {
  display: block;
  margin: 28rpx 0 12rpx;
  color: #3a3f4b;
  font-size: 26rpx;
  font-weight: 700;
}

.sub-body .input {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid #e6e8ee;
  border-radius: 8rpx;
}

.ph {
  color: #b0b6c0;
  font-size: 26rpx;
}

.sub-body button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
  box-sizing: border-box;
}

.ghost {
  color: #182850;
  background: #ffffff;
  border: 1rpx solid #182850;
}

.primary {
  color: #ffffff;
  background: #182850;
  border: 1rpx solid #182850;
}
