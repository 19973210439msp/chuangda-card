.sub-scroll {
  width: 100%;
  background: #f5f6f8;
}

.body {
  box-sizing: border-box;
  min-height: 100%;
  padding: 24rpx 0 48rpx;
}

.hint {
  display: block;
  padding: 8rpx 32rpx 20rpx;
  color: #8a9099;
  font-size: 24rpx;
  line-height: 1.5;
}

.group {
  background: #ffffff;
}

.row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  margin-left: 32rpx;
  padding-right: 32rpx;
  border-bottom: 1rpx solid #ededed;
}

.row:last-child {
  border-bottom: none;
}

.meta {
  flex: 1;
  min-width: 0;
}

.phone {
  display: block;
  color: #1a1a1a;
  font-size: 32rpx;
}

.sub {
  display: block;
  margin-top: 4rpx;
  color: #8a9099;
  font-size: 24rpx;
}

.current {
  color: #182850;
  font-size: 26rpx;
  font-weight: 700;
}

.add {
  margin: 24rpx 0 0;
  min-height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  background: #ffffff;
  color: #182850;
  font-size: 32rpx;
  font-weight: 700;
}
