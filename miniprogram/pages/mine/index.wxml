<image class="bg-img" src="/assets/bg-plain.jpg" mode="aspectFill"></image>
<nav-bar title="我的"></nav-bar>
<scroll-view class="mine-scroll" scroll-y style="height: {{scrollHeight}}px">
  <view class="mine-body">
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <view class="group">
      <view class="row" wx:if="{{!reviewEntry}}" bindtap="onPhone">
        <image class="ico" src="/assets/icons/switch-account.png" mode="aspectFit"></image>
        <text class="name">手机账号</text>
        <text class="value">{{phoneText || '未绑定'}}</text>
        <image class="chev" src="/assets/icons/arrow-right.png" mode="aspectFit"></image>
      </view>
      <view class="row">
        <image class="ico" src="/assets/icons/card-style.png" mode="aspectFit"></image>
        <text class="name">名片权限</text>
        <text class="value">{{permissionText}}</text>
      </view>
      <view class="row" wx:if="{{reviewEntry}}">
        <image class="ico" src="/assets/icons/switch-account.png" mode="aspectFit"></image>
        <text class="name">账号类型</text>
        <text class="value">微信审核体验</text>
      </view>
      <view class="row" wx:if="{{reviewEntry}}" bindtap="onSwitchAccount">
        <image class="ico" src="/assets/icons/switch-account.png" mode="aspectFit"></image>
        <text class="name">切换账号</text>
        <text class="value">使用个人账号登录</text>
        <image class="chev" src="/assets/icons/arrow-right.png" mode="aspectFit"></image>
      </view>
      <view class="row" bindtap="onClose">
        <image class="ico" src="/assets/icons/logout.png" mode="aspectFit"></image>
        <text class="name">注销账号</text>
        <image class="chev" src="/assets/icons/arrow-right.png" mode="aspectFit"></image>
      </view>
    </view>
  </view>
</scroll-view>
