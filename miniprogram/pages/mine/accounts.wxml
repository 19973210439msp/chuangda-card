<nav-bar title="账号管理"></nav-bar>
<scroll-view class="sub-scroll" scroll-y style="height: {{scrollHeight}}px">
  <view class="body">
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <text class="hint">当前账号就是已绑定的手机号。点击其他号码可切回该账号。</text>
    <view class="group">
      <view class="row" wx:for="{{accounts}}" wx:key="employeeId" data-id="{{item.employeeId}}" bindtap="onPick">
        <view class="meta">
          <text class="phone">{{item.phoneText}}</text>
          <text class="sub" wx:if="{{item.name}}">{{item.name}}</text>
        </view>
        <text class="current" wx:if="{{item.current}}">当前</text>
      </view>
    </view>
    <view class="add" bindtap="onAdd">添加账号</view>
  </view>
</scroll-view>
<app-tab></app-tab>
