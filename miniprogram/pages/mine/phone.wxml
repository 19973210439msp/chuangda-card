<nav-bar title="手机账号"></nav-bar>
<scroll-view class="sub-scroll" scroll-y style="height: {{scrollHeight}}px">
  <view class="sub-body">
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <view class="card-block">
      <text class="current">当前 {{currentText || '未绑定'}}</text>
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{phone}}" bindinput="onPhone" placeholder="请输入手机号" placeholder-class="ph" />
      <button class="primary" disabled="{{sending || countdown > 0}}" bindtap="onSend">{{countdown > 0 ? ('重新获取 ' + countdown + '秒') : '获取验证码'}}</button>
      <block wx:if="{{codeReady}}">
        <text class="label">验证码</text>
        <input class="input" type="number" maxlength="6" value="{{code}}" bindinput="onCode" placeholder="请输入 6 位验证码" placeholder-class="ph" />
        <text class="hint" wx:if="{{devHint}}">{{devHint}}</text>
        <button class="primary" loading="{{saving}}" bindtap="onSubmit">确认更换</button>
      </block>
    </view>
    <view class="card-block" wx:if="{{accounts.length}}">
      <text class="section">已验证的手机号</text>
      <view class="account" wx:for="{{accounts}}" wx:key="id">
        <view class="account-main">
          <text class="account-phone">{{item.phoneText}}</text>
          <text class="account-name">{{item.nameText}}</text>
        </view>
        <view class="account-switch" wx:if="{{!item.current}}" data-id="{{item.id}}" bindtap="onSwitch">切换</view>
      </view>
    </view>
  </view>
</scroll-view>
