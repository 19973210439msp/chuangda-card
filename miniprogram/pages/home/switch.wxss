.sub-body {
  padding-bottom: 48rpx;
}

.card-item {
  margin-bottom: 28rpx;
  padding: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.desc {
  display: block;
  margin: 0 0 20rpx;
  color: #5b6778;
  font-size: 24rpx;
  line-height: 1.5;
}

.create .desc {
  margin: 8rpx 0 16rpx;
}

.current {
  color: #1f8a84;
  font-size: 24rpx;
  font-weight: 600;
}

.head-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.remove {
  color: #c82423;
  font-size: 24rpx;
  font-weight: 600;
}

.meta {
  display: block;
  margin-top: 12rpx;
}

.create {
  margin-top: 12rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.tpl,
.meta {
  color: #5b6778;
  font-size: 24rpx;
}

.template-company {
  display: block;
  margin-top: 6rpx;
  color: #344463;
  font-size: 23rpx;
}

.style-item {
  margin-bottom: 24rpx;
  padding: 16rpx;
  border: 2rpx solid #e6e8ee;
  border-radius: 16rpx;
  background: #f7f8fa;
}

.style-item.on {
  border-color: #182850;
  background: #ffffff;
}
