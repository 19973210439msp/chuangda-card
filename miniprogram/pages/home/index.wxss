.tab-scroll {
  width: 100%;
  background: #ffffff;
}

.tab-body {
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.card-wrap,
.info,
.band {
  margin-top: 24rpx;
}


.card-wrap {
  position: relative;
  margin-top: 8rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 40, 80, 0.06);
}

.flip {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  z-index: 4;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(24, 40, 80, 0.88);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.card-wrap card-view .sheet,
.actions,
.info {
  border-radius: 16rpx;
}

.lite {
  display: flex;
  align-items: stretch;
  justify-content: space-evenly;
  margin-top: 0;
  padding: 16rpx 0 8rpx;
  border-top: 1rpx solid #e6e8ee;
}

.lite-item {
  flex: 1;
  min-height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1.3;
}

.lite-share {
  width: 100%;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: 1.3;
  font-weight: 700;
  color: #182850;
}

.lite-share::after {
  border: none;
}

.guide {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #182850;
  border-radius: 12rpx;
  background: #ffffff;
}

.guide-title {
  display: block;
  color: #182850;
  font-size: 32rpx;
  font-weight: 700;
}

.guide-desc {
  display: block;
  margin-top: 8rpx;
  color: #5c6370;
  font-size: 24rpx;
}

.section {
  display: block;
  margin-top: 28rpx;
  color: #182850;
  font-size: 28rpx;
  font-weight: 700;
}

.lite-item image {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
}

.lite-item text {
  color: #182850;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
}


.info {
  padding: 28rpx;
  border: 1rpx solid #e6e8ee;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 40, 80, 0.06);
}

.info .h1 {
  font-size: 36rpx;
}

.info .desc {
  margin-top: 12rpx;
  color: #8a9099;
  font-size: 24rpx;
}

.info .tag {
  margin-top: 20rpx;
}

.summary {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.metric {
  width: 48%;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 32rpx 28rpx;
  border-radius: 16rpx;
  background: #f4f6f9;
}

.num {
  display: block;
  color: #182850;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
}

.metric .label {
  display: block;
  margin-top: 10rpx;
  color: #8a9099;
  font-size: 22rpx;
  font-weight: 400;
}

.visits {
  margin-top: 28rpx;
}

.visit {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: #f4f6f9;
}

.who {
  display: block;
  color: #182850;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 4rpx;
  color: #5c6370;
  font-size: 24rpx;
}

.exchanged {
  color: #c82423;
  font-size: 22rpx;
  font-weight: 700;
}

.copy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(24, 40, 80, 0.45);
}

.copy-panel {
  width: 100%;
  padding: 36rpx 32rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.copy-title {
  display: block;
  color: #182850;
  font-size: 32rpx;
  font-weight: 700;
}

.copy-desc {
  display: block;
  margin-top: 12rpx;
  color: #5c6370;
  font-size: 24rpx;
  line-height: 1.5;
}

.copy-url {
  display: block;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #f4f6f9;
  color: #182850;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-all;
}

.copy-close {
  margin-top: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 8rpx;
  color: #ffffff;
  background: #182850;
  font-size: 28rpx;
  font-weight: 700;
}
