.bg-img {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
}

.tab-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  background-color: transparent;
  background-image: none;
}

.tab-body {
  position: relative;
  box-sizing: border-box;
  padding: 72rpx 32rpx 48rpx;
  padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.card-wrap,
.info,
.band {
  margin-top: 24rpx;
}


.card-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-top: 0;
  margin-bottom: 8rpx;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  box-sizing: border-box;
  overflow: visible;
}

.flip-hint {
  display: block;
  margin-top: 16rpx;
  color: #7d8794;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.4;
  text-align: center;
}

.actions,
.info {
  border-radius: 16rpx;
}

.lite-wrap {
  position: relative;
  margin-top: 36rpx;
}

.gold-dot {
  position: absolute;
  right: 10rpx;
  top: -40rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c6a56a;
  z-index: 2;
}

.lite {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  justify-content: space-between;
  width: 100%;
  margin-top: 0;
  padding: 0;
  gap: 12rpx;
  box-sizing: border-box;
}

.page-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 0 0 12rpx;
}

.page-mark {
  width: 12rpx;
  height: 78rpx;
  margin-top: -6rpx;
  margin-right: 16rpx;
  border-radius: 6rpx;
  background: #c23b3b;
}

.page-title {
  display: block;
  color: #1a2744;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.25;
}

.page-en {
  display: block;
  margin-top: 6rpx;
  color: #7d8694;
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 1.6rpx;
  line-height: 1.3;
}

.lite-item {
  position: relative;
  flex: 1;
  width: 0;
  max-width: none;
  min-width: 0;
  min-height: 132rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 4rpx 12rpx;
  margin: 0;
  background: #ffffff;
  border: 3rpx solid rgba(24, 44, 82, 0.72);
  border-radius: 22rpx;
  overflow: hidden;
}

.lite-on {
  background: rgba(15, 40, 89, 0.04);
  box-shadow: 0 4rpx 12rpx rgba(15, 40, 89, 0.08);
}

.lite-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 0;
  background: transparent;
  opacity: 0;
  z-index: 2;
}

.lite-hit::after {
  border: none;
}

.guide {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1px solid rgba(22, 64, 122, 0.15);
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(15, 40, 89, 0.08);
}

.guide-title {
  display: block;
  color: #182850;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
}

.guide-desc {
  display: block;
  margin-top: 8rpx;
  color: #5c6370;
  font-size: 24rpx;
}

.guide-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  margin: 24rpx 0 0;
  padding: 0 24rpx;
  border: none;
  border-radius: 12rpx;
  color: #ffffff;
  background: #182850;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 80rpx;
  box-sizing: border-box;
}

.guide-action::after {
  border: none;
}

.section {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  color: #0F2859;
  font-size: 34rpx;
  font-weight: 600;
}

.corp-foot-wrap {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
}

.corp-foot-block {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gold-bar {
  position: absolute;
  right: 100%;
  top: -8rpx;
  width: 128rpx;
  height: 18rpx;
  margin-right: 36rpx;
  border-radius: 10rpx;
  background: #c6a56a;
}

.corp-foot {
  display: block;
  margin-top: 0;
  color: #8b93a0;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}

.foot-red {
  width: 36rpx;
  height: 6rpx;
  margin: 12rpx auto 0;
  border-radius: 4rpx;
  background: #d23b45;
}

.lite-item image {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 8rpx;
  padding: 0;
  box-sizing: border-box;
  background: transparent;
  border-radius: 0;
}

.lite-item text {
  display: block;
  width: 100%;
  color: #3e4656;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.3;
  text-align: center;
  white-space: normal;
}


.info {
  padding: 28rpx;
  border: 1rpx solid #e6e8ee;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(24, 40, 80, 0.06);
}

.info .h1 {
  font-size: 36rpx;
}

.info .desc {
  margin-top: 12rpx;
  color: #8a9099;
  font-size: 24rpx;
}

.info .tag {
  margin-top: 20rpx;
}

.summary {
  margin-top: 0;
  margin-bottom: 40rpx;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.metric {
  position: relative;
  flex: 1;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 36rpx 28rpx 28rpx;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(15, 40, 89, 0.08);
  overflow: hidden;
}

.metric-ornament {
  position: absolute;
  top: 12rpx;
  right: 8rpx;
  width: 108rpx;
  height: 108rpx;
}

.num {
  display: block;
  color: #C02E28;
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.05;
  letter-spacing: -1rpx;
}

.metric .label {
  display: block;
  margin-top: 12rpx;
  color: #6d7585;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.3;
}

.metric-desc {
  display: block;
  margin-top: 8rpx;
  color: #8a9099;
  font-size: 22rpx;
  line-height: 1.4;
}

.metric-more {
  display: flex;
  flex-direction: row;
  align-items: center;
  align-self: flex-start;
  margin-top: 28rpx;
  padding: 8rpx 0;
}

.metric-more-text,
.metric-more-icon {
  color: #0F2859;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
}

.metric-more-icon {
  margin-left: 2rpx;
}

.visits {
  margin-top: 28rpx;
}

.visit {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: #f4f6f9;
}

.who {
  display: block;
  color: #182850;
  font-weight: 600;
}

.sub {
  display: block;
  margin-top: 4rpx;
  color: #5c6370;
  font-size: 24rpx;
}

.exchanged {
  color: #c82423;
  font-size: 22rpx;
  font-weight: 600;
}

.copy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: rgba(24, 40, 80, 0.45);
}

.copy-panel {
  width: 100%;
  padding: 36rpx 32rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

.copy-title {
  display: block;
  color: #182850;
  font-size: 32rpx;
  font-weight: 600;
}

.copy-desc {
  display: block;
  margin-top: 12rpx;
  color: #5c6370;
  font-size: 24rpx;
  line-height: 1.5;
}

.copy-url {
  display: block;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #f4f6f9;
  color: #182850;
  font-size: 26rpx;
  line-height: 1.5;
  word-break: break-all;
}

.copy-close {
  margin-top: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 8rpx;
  color: #ffffff;
  background: #182850;
  font-size: 28rpx;
  font-weight: 600;
}
