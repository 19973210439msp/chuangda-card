.hint {
  display: block;
  margin-top: 8rpx;
  color: #5c6370;
  font-size: 24rpx;
  line-height: 1.6;
}

.company-pick {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e6e8ee;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.company-pick-text {
  display: block;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #3a3f4b;
  font-size: 36rpx;
  line-height: 88rpx;
}

.company-pick-more {
  flex: none;
  margin-left: 16rpx;
  color: #182850;
  font-size: 28rpx;
  line-height: 88rpx;
}

.company-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.45);
}

.company-sheet {
  width: 100%;
  max-height: 70vh;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.company-sheet-title {
  display: block;
  color: #182850;
  font-size: 34rpx;
  font-weight: 600;
}

.company-list {
  max-height: 48vh;
  margin-top: 16rpx;
}

.company-option {
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #e6e8ee;
}

.company-option text {
  display: block;
  color: #3a3f4b;
  font-size: 30rpx;
  line-height: 1.5;
}

.company-option.on text {
  color: #182850;
  font-weight: 600;
}

.company-close {
  margin-top: 20rpx;
  height: 88rpx;
  border-radius: 8rpx;
  background: #f3f6fa;
  color: #182850;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.file-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e6e8ee;
}

.file-row text {
  flex: 1;
  min-width: 0;
  color: #3a3f4b;
  font-size: 26rpx;
}

.file-row button {
  width: auto;
  height: 64rpx;
  margin-top: 0;
  padding: 0 20rpx;
  line-height: 64rpx;
}

.lite {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.lite-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lite-item image {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

.lite-item text {
  color: #182850;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.lite-bar {
  color: #d0d4dc;
  font-size: 28rpx;
  line-height: 36rpx;
}

.qr-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.qr-upload {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-left: 20rpx;
}

.qr-upload image {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

.qr-upload text,
.qr-name {
  color: #182850;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.qr-preview {
  display: block;
  width: 160rpx;
  height: 160rpx;
  margin-top: 16rpx;
  margin-left: 0;
  background: #ffffff;
}

.card-block .label {
  margin: 28rpx 0 12rpx;
  color: #182850;
  font-size: 34rpx;
  font-weight: 600;
}

.sub-body .input {
  font-size: 36rpx;
}

.ph {
  color: #b0b6c0;
  font-size: 32rpx;
}

.hint {
  display: block;
  margin-top: 12rpx;
  color: #8a93a3;
  font-size: 24rpx;
  line-height: 1.5;
}
