<nav-bar title="编辑名片"></nav-bar>
<scroll-view class="sub-scroll" scroll-y style="height: {{scrollHeight}}px">
<view class="sub-body">
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="ok" wx:if="{{devHint}}">{{devHint}}</view>
  <view class="card-block">
    <text class="label">姓名</text>
    <input class="input" always-embed="{{true}}" adjust-position="{{true}}" cursor-spacing="96" data-key="name" value="{{form.name}}" bindinput="onInput" />
    <text class="label">公司</text>
    <view class="company-pick" bindtap="onOpenCompanies">
      <text class="company-pick-text">{{companyNames[companyIndex] || '总公司'}}</text>
      <text class="company-pick-more">选择</text>
    </view>
    <text class="hint">总公司可直接选择。已认证的子公司都会出现在这里，请自行选择要写到这张名片上的公司。</text>
    <text class="label">职业</text>
    <input class="input" always-embed="{{true}}" adjust-position="{{true}}" cursor-spacing="96" data-key="title" value="{{form.title}}" bindinput="onInput" />
    <text class="label">手机号</text>
    <input class="input" always-embed="{{true}}" adjust-position="{{true}}" cursor-spacing="96" data-key="phone" value="{{form.phone}}" bindinput="onInput" placeholder="名片上展示的手机号" placeholder-class="ph" />
    <text class="hint">可与微信授权登录的手机号不同，只影响这张名片上的联系电话。</text>
    <text class="label">邮箱</text>
    <input class="input" always-embed="{{true}}" adjust-position="{{true}}" cursor-spacing="96" data-key="email" value="{{form.email}}" bindinput="onInput" placeholder="选填" placeholder-class="ph" />
    <text class="label">地址</text>
    <input class="input" always-embed="{{true}}" adjust-position="{{true}}" cursor-spacing="96" data-key="address" value="{{form.address}}" bindinput="onInput" />
    <text class="label">名片附件</text>
    <view wx:for="{{form.attachments}}" wx:key="url" class="file-row">
      <text>{{item.name}}</text>
      <button class="ghost slim" data-index="{{index}}" bindtap="onRemoveFile">移除</button>
    </view>
    <view class="lite">
      <view class="lite-item" bindtap="onAddFile">
        <image src="/assets/icons/file.png" mode="aspectFit"></image>
        <text>附件提交</text>
      </view>
    </view>
  </view>
  <button class="primary" bindtap="onSave">保存</button>
</view>
</scroll-view>
<view class="company-mask" wx:if="{{companyOpen}}" bindtap="onCloseCompanies" catchtouchmove="onHoldCompanies">
  <view class="company-sheet" catchtap="onHoldCompanies">
    <text class="company-sheet-title">选择公司</text>
    <scroll-view class="company-list" scroll-y>
      <view
        class="company-option {{companyIndex === index ? 'on' : ''}}"
        wx:for="{{companies}}"
        wx:key="id"
        data-index="{{index}}"
        bindtap="onChooseCompany"
      >
        <text>{{item.name}}</text>
      </view>
    </scroll-view>
    <view class="company-close" bindtap="onCloseCompanies">关闭</view>
  </view>
</view>
<app-tab></app-tab>
