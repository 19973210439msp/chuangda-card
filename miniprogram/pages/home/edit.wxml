<nav-bar title="编辑名片"></nav-bar>
<scroll-view class="sub-scroll" scroll-y style="height: {{scrollHeight}}px">
<view class="sub-body">
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="ok" wx:if="{{devHint}}">{{devHint}}</view>
  <view class="card-block">
    <text class="label">头像</text>
    <button class="ghost" bindtap="onAvatar">{{form.avatar ? '重新上传头像' : '上传头像'}}</button>
    <text class="label">形象照</text>
    <button class="ghost" bindtap="onPortrait">{{form.portrait ? '重新上传形象照' : '上传形象照'}}</button>
    <text class="label">姓名</text>
    <input class="input" data-key="name" value="{{form.name}}" bindinput="onInput" />
    <text class="label">公司</text>
    <input class="input" data-key="company" value="{{form.company}}" bindinput="onInput" />
    <text class="label">职业</text>
    <input class="input" data-key="title" value="{{form.title}}" bindinput="onInput" />
    <text class="label">手机号</text>
    <input class="input" data-key="phone" value="{{form.phone}}" bindinput="onInput" />
    <block wx:if="{{form.phone !== origin.phone}}">
      <button class="ghost" bindtap="onPhoneCode">获取短信验证码</button>
      <input class="input" data-key="phoneCode" placeholder="6 位验证码" value="{{phoneCode}}" bindinput="onCode" />
    </block>
    <text class="label">微信号</text>
    <view class="lite">
      <view class="lite-item">
        <image src="/assets/icons/wechat.png" mode="aspectFit"></image>
        <text>提交微信号</text>
      </view>
      <text class="lite-bar">|</text>
      <view class="lite-item" bindtap="onWechatQr">
        <image src="{{wechatQr || '/assets/wechat-logo.jpg'}}" mode="aspectFit"></image>
        <text>上传微信二维码</text>
      </view>
    </view>
    <input class="input" data-key="wechat" placeholder="请输入微信号" placeholder-class="ph" value="{{form.wechat}}" bindinput="onInput" />
    <image wx:if="{{wechatQr}}" class="qr-preview" src="{{wechatQr}}" mode="aspectFit"></image>
    <text class="label">邮箱</text>
    <input class="input" data-key="email" value="{{form.email}}" bindinput="onInput" />
    <block wx:if="{{form.email !== origin.email}}">
      <button class="ghost" bindtap="onEmailCode">获取邮箱验证码</button>
      <input class="input" data-key="emailCode" placeholder="6 位验证码" value="{{emailCode}}" bindinput="onCode" />
    </block>
    <text class="label">地址</text>
    <input class="input" data-key="address" value="{{form.address}}" bindinput="onInput" />
    <text class="label">名片附件</text>
    <view wx:for="{{form.attachments}}" wx:key="url" class="file-row">
      <text>{{item.name}}</text>
      <button class="ghost slim" data-index="{{index}}" bindtap="onRemoveFile">移除</button>
    </view>
    <view class="lite">
      <view class="lite-item" bindtap="onAddFile">
        <image src="/assets/icons/file.png" mode="aspectFit"></image>
        <text>附件提交</text>
      </view>
    </view>
  </view>
  <button class="primary" bindtap="onSave">保存</button>
</view>
</scroll-view>
<app-tab></app-tab>
