<nav-bar title="浏览详情"></nav-bar>
<scroll-view class="sub-scroll" scroll-y style="height: {{scrollHeight}}px">
  <view class="body">
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <text class="count">共 {{items.length}} 次浏览</text>
    <view class="empty" wx:if="{{!items.length && !error}}">还没有人打开你的名片。</view>
    <view class="visit" wx:for="{{items}}" wx:key="id">
      <view class="visit-main">
        <text class="who">{{item.visitorId || '匿名访客'}}</text>
        <text class="sub">{{item.when}} · 停留 {{item.durationSec}} 秒</text>
        <text class="sub" wx:if="{{item.exchangeText}}">交换 {{item.exchangeText}}</text>
      </view>
      <text class="exchanged" wx:if="{{item.exchange}}">已交换</text>
    </view>
  </view>
</scroll-view>
<app-tab></app-tab>
