.card-wrap {
  position: relative;
}

.flip {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  z-index: 4;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(24, 40, 80, 0.88);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.ops {
  display: flex;
  flex-wrap: nowrap;
  align-items: stretch;
  gap: 8rpx;
  margin-top: 28rpx;
  padding: 8rpx 0 12rpx;
}

.bg-img {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
}

.sub-scroll {
  position: relative;
  z-index: 1;
  background: transparent;
}

.flip-hint {
  display: block;
  margin-top: 16rpx;
  color: #7d8794;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.4;
  text-align: center;
}

.page-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 0 0 12rpx;
}

.page-mark {
  width: 8rpx;
  height: 72rpx;
  margin-right: 16rpx;
  border-radius: 4rpx;
  background: #c23b3b;
}

.page-title {
  display: block;
  color: #1a2744;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
}

.page-en {
  display: block;
  margin-top: 6rpx;
  color: #8b93a0;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.op {
  position: relative;
  width: calc(25% - 16rpx);
  min-height: 148rpx;
  margin: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 16rpx 4rpx;
  background: #ffffff;
  border: 3rpx solid rgba(24, 44, 82, 0.72);
  border-radius: 22rpx;
}

.op-call {
  background: #182850;
  border-color: #182850;
}

.op text {
  margin-top: 10rpx;
  color: #182850;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
}

.op-call text {
  display: block;
  color: #ffffff;
}

.intro {
  margin-top: 20rpx;
  padding: 22rpx 24rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 3rpx solid rgba(24, 44, 82, 0.12);
}

.intro-title {
  display: block;
  color: #182850;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.intro-name {
  display: block;
  margin-top: 12rpx;
  color: #182850;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
}

.intro-text {
  display: block;
  margin-top: 10rpx;
  color: #5c6573;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.55;
}

.op image {
  width: 52rpx;
  height: 52rpx;
}

.op-share-wrap {
  padding: 16rpx 4rpx;
}

.op-share {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  opacity: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
}

.op-share::after {
  border: none;
}

.saved {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #e6e8ee;
  color: #182850;
  font-size: 26rpx;
}
.exchange {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e6e8ee;
  border-radius: 12rpx;
  background: #ffffff;
}
.contacts-title {
  display: block;
  color: #182850;
  font-size: 30rpx;
  font-weight: 600;
}
