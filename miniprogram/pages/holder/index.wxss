.bg-img {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
}

.tab-scroll {
  position: relative;
  z-index: 1;
  width: 100%;
  background-color: transparent;
  background-image: none;
}

.tab-body {
  position: relative;
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
  padding-bottom: calc(300rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

.search {
  margin-bottom: 20rpx;
}

.search-input {
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 38rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 40, 89, 0.06);
  color: #182850;
  font-size: 28rpx;
}

.search-ph {
  color: #b0b4bb;
}

.list {
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(15, 40, 89, 0.08);
  overflow: hidden;
}

.swipe {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid #e6e8ee;
}

.swipe:last-child {
  border-bottom: none;
}

.actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 280rpx;
  display: flex;
}

.act {
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.act.pin {
  background: #182850;
}

.act.del {
  background: #c82423;
}

.item {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 128rpx;
  padding: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
  transition: transform 0.16s ease;
}

.item.pinned {
  background: #ededed;
}

.item.dragging {
  transition: none;
}

.meta { flex: 1; min-width: 0; }

.who {
  display: block;
  color: #333333;
  font-size: 32rpx;
  font-weight: 600;
}

.sub {
  display: block;
  margin-top: 8rpx;
  color: #666666;
  font-size: 28rpx;
}

.scan-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(128rpx + constant(safe-area-inset-bottom));
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  z-index: 5;
}

.scan {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  height: 88rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999px;
  color: #ffffff;
  background: #0F2859;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.scan::after {
  border: none;
}

.scan image {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}
