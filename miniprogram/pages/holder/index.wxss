.tab-scroll {
  width: 100%;
  background: #ffffff;
}

.tab-body {
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
  padding-bottom: calc(300rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

.list {
  border: 1rpx solid #e6e8ee;
  border-radius: 12rpx;
  background: #ffffff;
}

.swipe {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid #e6e8ee;
}

.swipe:last-child {
  border-bottom: none;
}

.actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 280rpx;
  display: flex;
}

.act {
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.act.pin {
  background: #182850;
}

.act.del {
  background: #c82423;
}

.item {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 128rpx;
  padding: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
  transition: transform 0.16s ease;
}

.item.pinned {
  background: #ededed;
}

.item.dragging {
  transition: none;
}

.meta { flex: 1; min-width: 0; }

.who {
  display: block;
  color: #182850;
  font-size: 32rpx;
  font-weight: 700;
}

.sub {
  display: block;
  margin-top: 6rpx;
  color: #5c6370;
  font-size: 24rpx;
}

.scan-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(128rpx + constant(safe-area-inset-bottom));
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  z-index: 5;
}

.scan {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  height: 88rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 44rpx;
  color: #ffffff;
  background: #182850;
  border: none;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.scan::after {
  border: none;
}

.scan image {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}
