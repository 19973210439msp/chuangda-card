<nav-bar title="拍名片"></nav-bar>
<scroll-view class="sub-scroll" scroll-y style="height: {{scrollHeight}}px">
<view class="sub-body">
  <text class="h1">拍名片识别</text>
  <text class="desc">照片只上传到服务器识别。核对草稿后再写入名片夹，不会直接入库。</text>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <image wx:if="{{photo}}" class="preview" src="{{photo}}" mode="aspectFit"></image>
  <button class="ghost" bindtap="onChoose">拍摄或从相册选择</button>
  <button class="primary" disabled="{{recognizing}}" bindtap="onRecognize">{{recognizing ? '识别中' : '点击识别'}}</button>
  <view class="card-block" wx:if="{{draft}}">
    <text class="label">姓名</text>
    <input class="input" data-key="name" value="{{draft.name}}" bindinput="onDraft" />
    <text class="label">公司</text>
    <input class="input" data-key="company" value="{{draft.company}}" bindinput="onDraft" />
    <text class="label">职业</text>
    <input class="input" data-key="title" value="{{draft.title}}" bindinput="onDraft" />
    <text class="label">手机号</text>
    <input class="input" data-key="phone" value="{{draft.phone}}" bindinput="onDraft" />
    <text class="label">微信号</text>
    <input class="input" data-key="wechat" value="{{draft.wechat}}" bindinput="onDraft" />
    <text class="label">邮箱</text>
    <input class="input" data-key="email" value="{{draft.email}}" bindinput="onDraft" />
    <text class="label">地址</text>
    <input class="input" data-key="address" value="{{draft.address}}" bindinput="onDraft" />
    <button class="primary" disabled="{{saving}}" bindtap="onConfirm">{{saving ? '存入中' : '确认存入名片夹'}}</button>
  </view>
</view>
</scroll-view>
<app-tab></app-tab>
