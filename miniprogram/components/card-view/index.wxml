<view class="sheet sheet-wave" wx:if="{{card && flipped && card.cardTemplate === 'wave'}}">
  <image class="back-img" src="/assets/wave-back.jpg" mode="scaleToFill"></image>
</view>
<view class="sheet back" wx:elif="{{card && flipped}}">
  <image class="back-img" src="/assets/card-back.png" mode="scaleToFill"></image>
</view>
<view class="sheet sheet-horizon" wx:elif="{{card && card.cardTemplate === 'horizon'}}">
  <view class="hz-side">
    <text class="hz-brand">{{company.shortName || '创大产控'}}</text>
    <text class="hz-name">{{card.name || '未填写姓名'}}</text>
    <text class="hz-title">{{card.title}}</text>
  </view>
  <view class="hz-main">
    <text class="hz-company">{{company.name || card.company}}</text>
    <text class="hz-line">手机 {{card.phone}}</text>
    <text class="hz-line">邮箱 {{card.email}}</text>
    <text class="hz-line">地址 {{card.address || company.address}}</text>
    <image class="hz-qr" src="{{company.qrSrc || '/assets/official-qr.jpg'}}" mode="aspectFit" show-menu-by-longpress="{{true}}" bindtap="onScanOfficial"></image>
  </view>
</view>
<view class="sheet sheet-wave" wx:elif="{{card && card.cardTemplate === 'wave'}}">
  <image class="wave-bg" src="/assets/wave-front.jpg" mode="scaleToFill"></image>
  <text class="wv-name">{{card.name || '未填写姓名'}}</text>
  <text class="wv-title">{{card.title}}</text>
  <view class="wv-row wv-phone"><text>{{card.phone}}</text></view>
  <view class="wv-row wv-email"><text>{{card.email}}</text></view>
  <view class="wv-row wv-address"><text>{{card.address || company.address}}</text></view>
  <image class="wv-qr" src="{{company.qrSrc || '/assets/official-qr.jpg'}}" mode="aspectFit" show-menu-by-longpress="{{true}}" bindtap="onScanOfficial"></image>
</view>
<view class="sheet" wx:elif="{{card}}">
  <view class="corp">
    <text class="corp-cn" style="transform: scaleX({{corpCnScale}});">{{company.name}}</text>
    <view class="en-clip">
      <text class="corp-en" style="transform: scaleX({{corpScale}});">{{company.nameEn}}</text>
    </view>
  </view>
  <view class="brand">
    <view class="seal">
      <image class="seal-img" src="/assets/brand-logo.png" mode="aspectFit"></image>
    </view>
    <view class="brand-names">
      <text class="brand-cn">{{company.shortName || '创大产控'}}</text>
      <view class="en-clip center">
        <text class="brand-en" style="transform: scaleX({{brandScale}});">{{company.brandEn}}</text>
      </view>
    </view>
  </view>
  <view class="who">
    <text class="name">{{card.name}}</text>
    <text class="title">{{card.title}}</text>
  </view>
  <text class="mobile">M:{{card.phone}}</text>
  <view class="tick"></view>
  <view class="contact">
    <text>电话/Tel:{{company.phone}}</text>
    <text>邮箱/E-mail:{{card.email}}</text>
    <text>地址/Add:{{card.address || company.address}}</text>
  </view>
  <view class="qr">
    <image class="qr-img" src="{{company.qrSrc || '/assets/official-qr.jpg'}}" mode="aspectFit" show-menu-by-longpress="{{true}}" bindtap="onScanOfficial"></image>
  </view>
</view>
