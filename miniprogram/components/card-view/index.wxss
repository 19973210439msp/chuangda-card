.sheet {
  position: relative;
  width: 100%;
  height: auto;
  aspect-ratio: 627 / 383;
  margin-top: 0;
  background: #ffffff;
  color: #182850;
  overflow: hidden;
  border-radius: 16rpx;
  box-shadow: 0 0 18rpx 4rpx rgba(0, 0, 0, 0.28), 0 10rpx 28rpx rgba(0, 0, 0, 0.22);
  font-family: "Source Han Sans SC", "Noto Sans SC", "Source Han Sans", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.sheet.back {
  background-color: #18214d;
  line-height: 0;
}

.back-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

:host {
  display: block;
  width: 100%;
}

.corp {
  position: absolute;
  left: 4.2%;
  top: 8%;
  right: 30%;
}

.corp-cn,
.corp-en,
.brand-cn,
.brand-en,
.name,
.title,
.mobile,
.contact text {
  display: block;
}

.corp-cn {
  display: inline-block;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
  transform-origin: left center;
}

.en-clip {
  width: 100%;
  margin-top: 0;
  overflow: visible;
  line-height: 1;
}

.en-clip.center {
  text-align: center;
}

.corp .en-clip {
  position: relative;
  width: 100%;
  height: 16rpx;
  margin-top: -6rpx;
  overflow: hidden;
}

.corp-en {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  height: 16rpx;
  font-size: 10rpx;
  font-weight: 700;
  line-height: 16rpx;
  letter-spacing: -0.6rpx;
  white-space: nowrap;
  transform-origin: left center;
}

.brand {
  position: absolute;
  left: 72.5%;
  right: 3.4%;
  top: 4%;
  width: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.seal {
  width: 112rpx;
  height: 112rpx;
  margin: 0 0 0 14rpx;
  flex-shrink: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #ffffff;
}

.seal-img {
  width: 112rpx;
  height: 112rpx;
}

.brand-names {
  display: inline-flex;
  flex-direction: column;
  align-items: stretch;
  align-self: center;
  width: auto;
  margin-top: 8rpx;
}

.brand .en-clip {
  position: relative;
  width: 100%;
  height: 16rpx;
  margin-top: 2rpx;
  overflow: visible;
  text-align: left;
}

.brand-cn {
  display: block;
  margin-top: 0;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  text-align: left;
  white-space: nowrap;
}

.brand-en {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  height: 16rpx;
  font-size: 10rpx;
  font-weight: 700;
  letter-spacing: -0.8rpx;
  line-height: 16rpx;
  text-align: left;
  white-space: nowrap;
  transform-origin: left center;
}

.who {
  position: absolute;
  left: 4.2%;
  top: 38%;
  display: flex;
  align-items: baseline;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.title {
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
}

.mobile {
  position: absolute;
  left: 4.2%;
  top: 50%;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
}

.tick {
  position: absolute;
  left: 0;
  bottom: 6%;
  width: 2.2%;
  height: 18%;
  background: #182850;
}

.contact {
  position: absolute;
  left: 4.2%;
  bottom: 6%;
  width: 62%;
}

.contact text {
  font-size: 18rpx;
  line-height: 1.55;
  font-weight: 500;
}

.qr {
  position: absolute;
  left: 72.5%;
  right: 3.4%;
  top: 64%;
  bottom: auto;
  width: auto;
  height: auto;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  background: transparent;
  z-index: 2;
}

.qr-img {
  width: 88%;
  height: auto;
  aspect-ratio: 1;
}

.sheet-wave {
  aspect-ratio: 1004 / 591;
  background: #ffffff;
}

.wave-bg,
.sheet-wave .back-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.wv-name {
  position: absolute;
  left: 7%;
  top: 18%;
  color: #1d5fbf;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}

.wv-title {
  position: absolute;
  left: 46%;
  top: 22%;
  color: #1d4e89;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
}

.wv-row {
  position: absolute;
  left: 16%;
  right: 28%;
  height: 6.2%;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.wv-row text {
  color: #24558f;
  font-size: 22rpx;
  line-height: 1;
}

.wv-phone { top: 54.3%; }
.wv-email { top: 63.6%; }
.wv-address { top: 72.9%; }

.wv-qr {
  position: absolute;
  right: 8%;
  top: 54%;
  width: 18%;
  height: auto;
  aspect-ratio: 1;
  background: #ffffff;
}

.sheet-horizon {
  display: flex;
  background: #f4f7fb;
  color: #10233f;
}

.hz-side {
  width: 248rpx;
  padding: 36rpx 24rpx;
  background: #10233f;
  color: #ffffff;
}

.hz-brand,
.hz-name,
.hz-title,
.hz-company,
.hz-line {
  display: block;
}

.hz-brand {
  color: #8ec8c4;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.hz-name {
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hz-title {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hz-main {
  position: relative;
  flex: 1;
  padding: 28rpx 24rpx 24rpx 28rpx;
}

.hz-main::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: #1f8a84;
}

.hz-company {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hz-line {
  margin-top: 14rpx;
  font-size: 20rpx;
  line-height: 1.4;
}

.hz-qr {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  width: 96rpx;
  height: 96rpx;
  background: #ffffff;
}
