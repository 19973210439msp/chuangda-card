.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #182850;
}
.back {
  position: absolute;
  left: 8rpx;
  bottom: 0;
  width: 64rpx;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chevron {
  width: 48rpx;
  height: 48rpx;
}
.title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44px;
  text-align: center;
}
