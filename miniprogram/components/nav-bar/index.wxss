.nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 20;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #CDD4E3;
  border-bottom: 1rpx solid rgba(26, 39, 68, 0.16);
}
.nav-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
}
.back {
  position: absolute;
  left: 8rpx;
  bottom: 0;
  z-index: 1;
  width: 64rpx;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chevron {
  width: 48rpx;
  height: 48rpx;
}
.title {
  position: relative;
  z-index: 1;
  color: #1a2744;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 44px;
  text-align: center;
}
