page {
  background: #ffffff;
  color: #3a3f4b;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: "Source Han Sans SC", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.h1 {
  display: block;
  color: #182850;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.desc,
.lede {
  display: block;
  margin-top: 8rpx;
  color: #5c6370;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.6;
}

.tag {
  display: inline-block;
  margin-top: 28rpx;
  padding: 6rpx 16rpx;
  background: #182850;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.panel,
.card-block {
  margin-top: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e6e8ee;
  border-radius: 12rpx;
  background: #ffffff;
}

.section {
  display: block;
  color: #182850;
  font-size: 30rpx;
  font-weight: 700;
}

.label {
  display: block;
  margin: 20rpx 0 8rpx;
  color: #5c6370;
  font-size: 24rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid #e6e8ee;
  padding: 18rpx 20rpx;
  border-radius: 8rpx;
  color: #3a3f4b;
}

.primary,
.ghost,
.danger {
  margin-top: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 84rpx;
  height: 84rpx;
}

.primary {
  color: #ffffff;
  background: #182850;
  border: 1rpx solid #182850;
}

.ghost {
  color: #182850;
  background: #ffffff;
  border: 1rpx solid #182850;
}

.danger {
  color: #c82423;
  background: #ffffff;
  border: 1rpx solid #c82423;
}

.row-actions {
  display: flex;
  gap: 16rpx;
}

.row-actions button {
  flex: 1;
  margin-top: 0;
}

.row-actions + .row-actions {
  margin-top: 16rpx;
}

button::after {
  border: none;
}

.error {
  color: #c82423;
  background: #fdf2f2;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  margin: 16rpx 0;
}

.ok {
  color: #182850;
  background: #f4f6fa;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
}

.empty {
  margin-top: 24rpx;
  padding: 40rpx 28rpx;
  border: 1rpx solid #e6e8ee;
  border-radius: 12rpx;
  color: #5c6370;
  text-align: center;
}

.band {
  margin-top: 48rpx;
  padding: 28rpx 28rpx;
  background: #182850;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.bars {
  position: relative;
  width: 88rpx;
  height: 56rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.bars .b {
  width: 14rpx;
  background: #ffffff;
}

.bars .b1 { height: 16rpx; }
.bars .b2 { height: 28rpx; }
.bars .b3 { height: 40rpx; }
.bars .b4 { height: 52rpx; }

.bars .tip {
  position: absolute;
  right: -8rpx;
  top: -6rpx;
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 16rpx solid #c82423;
}

.slogan {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.sub-scroll {
  width: 100%;
  background: #ffffff;
}

.sub-body {
  box-sizing: border-box;
  padding: 32rpx 32rpx 48rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.sub-body .card-block,
.sub-body .panel,
.sub-body .exchange {
  margin-top: 24rpx;
  padding: 32rpx 28rpx 36rpx;
}

.sub-body .input {
  height: 88rpx;
  margin-top: 0;
  padding: 0 24rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.sub-body button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
  box-sizing: border-box;
}

.sub-body .primary {
  color: #ffffff;
  background: #182850;
  border: 1rpx solid #182850;
}

.sub-body .ghost {
  color: #182850;
  background: #ffffff;
  border: 1rpx solid #182850;
}
