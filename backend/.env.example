# 存储：json（data.json）或 pg-oss。方案 2 缺数据库或 OSS 时启动失败，不会退回 JSON
STORAGE_DRIVER=pg-oss

# 方案 1 可改数据文件位置。不设置时使用 backend/data.json
# DATA_FILE=./data.json

PORT=3000
# 本地调试用 development。服务器正式运行改为 production，并关闭 SKIP_WECHAT_AUTH
NODE_ENV=development
# 浏览器只允许这些来源调用接口，多个用英文逗号分隔。
# 不填时使用 PUBLIC_BASE_URL。生产环境还会拒绝用 IP 或其他 Host 访问。
# 小程序不走浏览器 CORS，按其固定 Referer（servicewechat.com/本小程序AppID）放行。
# CORS_ORIGINS=https://business-card.cdckgroup.com

# 管理后台账号。生产环境必须设置，不写进仓库
ADMIN_USER=admin
ADMIN_PASS=
# 管理员登录：同一 IP+用户名失败 5 次后锁定 15 分钟。改密码后旧管理员 token 立即失效。
# LOGIN_FAIL_LIMIT=5
# LOGIN_LOCK_MS=900000
# ADMIN_SESSION_MS=43200000
# EMPLOYEE_SESSION_MS=604800000
# 过期/已用验证码清理间隔（毫秒）。默认 6 小时；删除员工时也会清掉该用户的验证码。
# CODE_PURGE_MS=21600000

# 对外访问根地址，用于上传文件和分享链接。不设置时用请求的 Host
# PUBLIC_BASE_URL=https://business-card.cdckgroup.com

# 小程序微信登录。本地可跳过；正式发布必须为 false，并填写 AppID / AppSecret
WECHAT_APPID=
WECHAT_SECRET=
SKIP_WECHAT_AUTH=true

# 方案 2：个人名片进 PostgreSQL，名片夹引用和上传文件进 OSS
DATABASE_URL=postgres://postgres:密码@127.0.0.1:5432/chuangda_card
PGSSL=
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=chuangda-card
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
# 名片图片和附件的公网访问根地址。不填则使用 OSS 返回的对象地址
OSS_PUBLIC_BASE=

# 腾讯云名片识别。未配置时接口返回「识别未配置」
OCR_PROVIDER=tencent
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# TENCENT_OCR_REGION=ap-guangzhou

# 腾讯云国内短信。五项都填上后，获取验证码会发到手机，不再返回测试码。
# 密钥与上面的名片识别共用。签名、应用 ID、模板 ID 在短信控制台审核通过后填写。
# 模板只有 {1} 时不要填分钟数；模板是 {1} 验证码、{2} 分钟时填 10。
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
# TENCENT_SMS_EXPIRE_MINUTES=10
# TENCENT_SMS_REGION=ap-guangzhou
